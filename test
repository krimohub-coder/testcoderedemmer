-- ============================================
-- AUTO BUY
-- ============================================
local function isPrompt(obj)
    if not obj or not obj:IsA("ProximityPrompt") then return false end
    local p = obj.Parent
    if not p or p.Name ~= "PromptAttachment" then return false end
    return true
end

local function getPos(prompt)
    if prompt and prompt.Parent then
        local part = prompt.Parent.Parent
        if part and part:IsA("BasePart") then
            return part.Position
        end
    end
    return nil
end

local function hold(prompt)
    pcall(function()
        prompt:InputHoldBegin(Enum.UserInputType.MouseButton1)
        prompt:InputHoldBegin(Enum.UserInputType.Touch)
    end)
end

local function release(prompt)
    pcall(function()
        prompt:InputHoldEnd(Enum.UserInputType.MouseButton1)
        prompt:InputHoldEnd(Enum.UserInputType.Touch)
    end)
end

local function addPrompt(obj)
    if isPrompt(obj) and not prompts[obj] then
        prompts[obj] = true
    end
end

local function startBuy()
    if buying then return end
    buying = true
    
    for _, obj in ipairs(Workspace:GetDescendants()) do
        addPrompt(obj)
    end
    
    promptConn = Workspace.DescendantAdded:Connect(addPrompt)
    
    renderConn = RunService.RenderStepped:Connect(function()
        if not buying then return end
        local char = LP.Character
        if not char then return end
        local root = char:FindFirstChild("HumanoidRootPart")
        if not root then return end
        
        for prompt, _ in pairs(prompts) do
            if prompt and prompt.Parent and isPrompt(prompt) then
                local pos = getPos(prompt)
                if pos then
                    local dist = (root.Position - pos).Magnitude
                    if dist < 15 then
                        hold(prompt)
                    else
                        release(prompt)
                    end
                else
                    prompts[prompt] = nil
                end
            else
                prompts[prompt] = nil
            end
        end
    end)
    
    setStatus("Auto Buy ON", Color3.fromRGB(80, 255, 120))
end

local function stopBuy()
    buying = false
    if renderConn then renderConn:Disconnect() renderConn = nil end
    if promptConn then promptConn:Disconnect() promptConn = nil end
    for prompt, _ in pairs(prompts) do
        release(prompt)
    end
    prompts = {}
    setStatus("Auto Buy OFF", Color3.fromRGB(255, 200, 50))
end

local function toggleBuy()
    if buying then
        stopBuy()
        ABB.Text = "Auto Buy"
        ABB.BackgroundColor3 = Color3.fromRGB(14, 14, 24)
        ABB.TextColor3 = Color3.fromRGB(200, 200, 220)
        ABBS.Color = Color3.fromRGB(30, 30, 50)
        ABBS.Transparency = 0.5
    else
        startBuy()
        ABB.Text = "Stop Buy"
        ABB.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
        ABB.TextColor3 = Color3.fromRGB(255, 255, 255)
        ABBS.Color = Color3.fromRGB(200, 50, 50)
        ABBS.Transparency = 0.3
    end
end

ABB.MouseButton1Click:Connect(toggleBuy)

