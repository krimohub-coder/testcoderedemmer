-- ============================================
-- AUTO BUY
-- ============================================
local function isPrompt(obj)
    if not obj or not obj:IsA("ProximityPrompt") then return false end
    local p = obj.Parent
    if not p or p.Name ~= "PromptAttachment" then return false end
    return true
end

local function getPos(prompt)
    if prompt and prompt.Parent then
        local part = prompt.Parent.Parent
        if part and part:IsA("BasePart") then
            return part.Position
        end
    end
    return nil
end

local function hold(prompt)
    pcall(function()
        prompt:InputHoldBegin(Enum.UserInputType.MouseButton1)
    end)
end

local function release(prompt)
    pcall(function()
        prompt:InputHoldEnd(Enum.UserInputType.MouseButton1)
    end)
end

local function addPrompt(prompt)
    if isPrompt(prompt) and not PP[prompt] then
        PP[prompt] = true
    end
end

local function startBuy()
    if AB then return end
    AB = true
    
    for _, obj in ipairs(W:GetDescendants()) do
        addPrompt(obj)
    end
    
    PC = W.DescendantAdded:Connect(addPrompt)
    
    RC = R.RenderStepped:Connect(function()
        if not AB then return end
        local char = L.Character
        if not char then return end
        local root = char:FindFirstChild("HumanoidRootPart")
        if not root then return end
        
        for prompt, _ in pairs(PP) do
            if prompt and prompt.Parent and isPrompt(prompt) then
                local pos = getPos(prompt)
                if pos then
                    local dist = (root.Position - pos).Magnitude
                    if dist < 15 then
                        hold(prompt)
                    else
                        release(prompt)
                    end
                else
                    PP[prompt] = nil
                end
            else
                PP[prompt] = nil
            end
        end
    end)
    
    setStatus("Auto Buy ON", Color3.fromRGB(80, 255, 120))
end

local function stopBuy()
    AB = false
    if RC then RC:Disconnect() RC = nil end
    if PC then PC:Disconnect() PC = nil end
    for prompt, _ in pairs(PP) do
        release(prompt)
    end
    PP = {}
    setStatus("Auto Buy OFF", Color3.fromRGB(255, 200, 50))
end

local function toggleBuy()
    if AB then
        stopBuy()
        ABB.Text = "Auto Buy"
        ABB.BackgroundColor3 = Color3.fromRGB(14, 14, 24)
        ABB.TextColor3 = Color3.fromRGB(200, 200, 220)
    else
        startBuy()
        ABB.Text = "Stop Buy"
        ABB.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
        ABB.TextColor3 = Color3.fromRGB(255, 255, 255)
    end
end

