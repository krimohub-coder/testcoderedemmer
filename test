local hooked = false

task.spawn(function()
    local ok, net = pcall(function()
        return RS:WaitForChild("Packages", 8):WaitForChild("Net", 8)
    end)
    if not ok or not net then
        setStatus("No Net found", Color3.fromRGB(255, 80, 80))
        return
    end

    local function scan(parent)
        for _, child in ipairs(parent:GetChildren()) do
            if child:IsA("RemoteEvent") and not hooked then
                child.OnClientEvent:Connect(function(a)
                    if type(a) == "string" and #a > 0 then
                        pasteCode(a)
                    end
                end)
                hooked = true
                setStatus("Listening!", Color3.fromRGB(80, 255, 120))
                break
            end
            pcall(scan, child)
        end
    end
    scan(net)
end)

