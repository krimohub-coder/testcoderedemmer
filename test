-- REMOTE HOOK (EINFACH & SICHER)
-- ============================================
task.spawn(function()
    local ok, net = pcall(function()
        return RS:WaitForChild("Packages", 10):WaitForChild("Net", 10)
    end)
    if not ok or not net then
        setStatus("Net folder missing", Color3.fromRGB(255, 80, 80))
        return
    end

    local function scan(parent)
        for _, child in ipairs(parent:GetChildren()) do
            if child:IsA("RemoteEvent") and not hooked then
                child.OnClientEvent:Connect(function(a)
                    if type(a) == "string" and #a > 0 then
                        pasteCode(a)
                    end
                end)
                hooked = true
                setStatus("Listening!", Color3.fromRGB(80, 255, 120))
                return
            end
            pcall(scan, child)
        end
    end
    scan(net)
end)

