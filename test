-- AFTER BOX
-- ============================================
AFB:GetPropertyChangedSignal("Text"):Connect(function()
    local text = AFB.Text
    if text ~= "" and not tonumber(text) then
        AFB.Text = text:gsub("[^%d]", "")
        return
    end
    if text == "" then return end
    local num = tonumber(text)
    if num then
        if num < 1 then
            AFB.Text = "1"
            num = 1
        elseif num > 10 then
            AFB.Text = "10"
            num = 10
        end
        target = num
        updateWords()
    end
end)

AFB.FocusLost:Connect(function()
    if AFB.Text == "" then
        AFB.Text = "3"
        target = 3
        updateWords()
    end
end)

-- ============================================
-- DRAG
-- ============================================
local drag, dragStart, startPos

FR.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then
        drag = true
        dragStart = input.Position
        startPos = FR.Position
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if drag and (input.UserInputType == Enum.UserInputType.MouseMovement
    or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position - dragStart
        FR.Position = UDim2.new(
            startPos.X.Scale, startPos.X.Offset + delta.X,
            startPos.Y.Scale, startPos.Y.Offset + delta.Y
        )
    end
end)

FR.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then
        drag = false
    end
end)

