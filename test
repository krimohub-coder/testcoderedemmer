-- ============================================
-- AFTER BOX
-- ============================================
AFB:GetPropertyChangedSignal("Text"):Connect(function()
    local text = AFB.Text
    if text ~= "" and not tonumber(text) then
        AFB.Text = text:gsub("[^%d]", "")
        return
    end
    if text == "" then return end
    local num = tonumber(text)
    if num then
        if num < 1 then
            AFB.Text = "1"
            num = 1
        elseif num > 10 then
            AFB.Text = "10"
            num = 10
        end
        target = num
        updateWords()
    end
end)

AFB.FocusLost:Connect(function()
    if AFB.Text == "" then
        AFB.Text = "3"
        target = 3
        updateWords()
    end
end)

