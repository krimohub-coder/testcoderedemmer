-- PRESS ENTER
local function pressEnter()
    pcall(function()
        VIM:SendKeyEvent(true, Enum.KeyCode.Return, false, game)
        VIM:SendKeyEvent(false, Enum.KeyCode.Return, false, game)
    end)
    pcall(function()
        if box and box:IsA("TextBox") then box:ReleaseFocus(true) end
    end)
    pcall(function()
        for _, obj in ipairs(PG:GetDescendants()) do
            if (obj:IsA("TextButton") or obj:IsA("ImageButton")) and obj.Visible then
                local n = string.lower(obj.Name)
                local t = obj:IsA("TextButton") and string.lower(obj.Text) or ""
                if n:find("submit") or n:find("redeem") or n:find("claim") or
                   t:find("submit") or t:find("redeem") or t:find("claim") then
                    if obj:FindFirstChild("MouseButton1Click") then
                        for _, c in ipairs(getconnections(obj.MouseButton1Click)) do
                            pcall(function() c:Fire() end)
                        end
                    end
                    break
                end
            end
        end
    end)
end

-- COLLECT & REDEEM
local function collectAndRedeem(code)
    if not code or code == "" then return end
    if not enabled then return end
    
    local clean = string.upper(string.gsub(code, "%s+", ""))
    table.insert(codes, clean)
    count = #codes
    updateWords()
    setStatus(count.."/"..target.." codes", Color3.fromRGB(80, 220, 100))
    
    if count >= target then
        setStatus("Redeeming...", Color3.fromRGB(80, 255, 120))
        if box and box:IsA("TextBox") then
            local combined = table.concat(codes, " ")
            pcall(function() box.Text = combined end)
        end
        task.wait(0.05)
        pressEnter()
        enabled = false
        OB.Text = "OFF"
        OB.BackgroundColor3 = Color3.fromRGB(220, 60, 60)
        OB.TextColor3 = Color3.fromRGB(255, 255, 255)
        setStatus("Redeemed!", Color3.fromRGB(255, 200, 50))
        codes = {}
        count = 0
        updateWords()
    end
end

-- PASTE CODE
local function pasteCode(text)
    if not enabled then return end
    local code = text:gsub("%s+", "")
    if code == "" then return end
    if not box then
        setStatus("Pick a box first!", Color3.fromRGB(255, 80, 80))
        return
    end
    if not box.Parent then
        setStatus("Box gone!", Color3.fromRGB(255, 80, 80))
        box = nil
        return
    end
    if box.Text == "" or box.Text == " " then
        box.Text = code
    else
        box.Text = box.Text .. "\n" .. code
    end
    setStatus("Pasted: " .. code, Color3.fromRGB(80, 255, 120))
    collectAndRedeem(code)
end

