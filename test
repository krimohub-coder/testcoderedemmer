-- ============================================
-- AFTER BOX
-- ============================================
AFB:GetPropertyChangedSignal("Text"):Connect(function()
    local text = AFB.Text
    if text ~= "" and not tonumber(text) then
        AFB.Text = text:gsub("[^%d]", "")
        return
    end
    if text == "" then return end
    local num = tonumber(text)
    if num ~= nil then
        if num < 1 then
            AFB.Text = "1"
            num = 1
        elseif num > 10 then
            AFB.Text = "10"
            num = 10
        end
        TC = num
        updateWords()
    end
end)

AFB.FocusLost:Connect(function()
    if AFB.Text == "" then
        AFB.Text = "3"
        TC = 3
        updateWords()
    end
end)

-- ============================================
-- PRESS ENTER
-- ============================================
local function pressEnter()
    pcall(function()
        V:SendKeyEvent(true, Enum.KeyCode.Return, false, game)
        V:SendKeyEvent(false, Enum.KeyCode.Return, false, game)
    end)
    
    pcall(function()
        if T and T:IsA("TextBox") then
            T:ReleaseFocus(true)
        end
    end)
    
    pcall(function()
        if G then
            for _, obj in ipairs(G:GetDescendants()) do
                if (obj:IsA("TextButton") or obj:IsA("ImageButton")) and obj.Visible then
                    local name = string.lower(obj.Name)
                    local text = obj:IsA("TextButton") and string.lower(obj.Text) or ""
                    if name:find("submit") or name:find("redeem") or name:find("claim") or
                       text:find("submit") or text:find("redeem") or text:find("claim") then
                        if obj:FindFirstChild("MouseButton1Click") then
                            for _, conn in ipairs(getconnections(obj.MouseButton1Click)) do
                                pcall(function() conn:Fire() end)
                            end
                        end
                        break
                    end
                end
            end
        end
    end)
end

-- ============================================
-- COLLECT & REDEEM
-- ============================================
local function collectAndRedeem(code)
    if not code or code == "" then return end
    if not E then return end
    if PL then return end
    PL = true
    
    local clean = string.upper(string.gsub(code, "%s+", ""))
    
    table.insert(C, clean)
    WC = #C
    updateWords()
    
    setStatus(WC.."/"..TC.." codes", Color3.fromRGB(80, 220, 100))
    flashCode(clean)
    
    if WC >= TC then
        setStatus("Redeeming...", Color3.fromRGB(80, 255, 120))
        
        if T and T:IsA("TextBox") then
            local combined = table.concat(C, " ")
            pcall(function()
                T.Text = combined
                T.CursorPosition = #combined + 1
            end)
        end
        
        task.wait(0.01)
        pressEnter()
        
        E = false
        OB.Text = "OFF"
        OB.BackgroundColor3 = Color3.fromRGB(220, 60, 60)
        OB.TextColor3 = Color3.fromRGB(255, 255, 255)
        setStatus("Redeemed! Auto OFF", Color3.fromRGB(255, 200, 50))
        
        C = {}
        WC = 0
        updateWords()
    end
    
    PL = false
end

-- ============================================
-- PASTE CODE
-- ============================================
local function pasteCode(text)
    if not E then return end
    
    local code = text:gsub("%s+", "")
    if code == "" then return end

    if not T then
        setStatus("No box selected — click Pick Box", Color3.fromRGB(255, 80, 80))
        return
    end

    if not T.Parent then
        setStatus("Box gone — pick again", Color3.fromRGB(255, 80, 80))
        T = nil
        return
    end

    if T.Text == "" or T.Text == " " then
        T.Text = code
    else
        T.Text = T.Text .. "\n" .. code
    end

    setStatus("Pasted: " .. code, Color3.fromRGB(80, 255, 120))
    flashCode(code)
    
    collectAndRedeem(code)
end

-- ============================================
-- REMOTE HOOK
-- ============================================
local HASH = "631ab0616c0445747139929dee141f4f24b2d7393b69ef081421b99587bfe780"
local remote = nil

local function isBroadcast(a, b, c)
    if type(a) ~= "string" then return false end
    if #a < 1 or #a > 500 then return false end
    if type(b) ~= "number" then return false end
    if type(c) ~= "string" then return false end
    if not c:find("Sounds", 1, true) then return false end
    return true
end

local function hook(rem)
    if remote then return end
    remote = rem
    setStatus("Listening — pick a box!", Color3.fromRGB(80, 255, 120))
    rem.OnClientEvent:Connect(function(a, b, c)
        if type(a) == "string" and #a > 0 then
            pasteCode(a)
        end
    end)
end

task.spawn(function()
    local ok, net = pcall(function()
        return S:WaitForChild("Packages", 10):WaitForChild("Net", 10)
    end)
    if not ok or not net then
        setStatus("Net folder missing", Color3.fromRGB(255, 80, 80))
        return
    end

    local function findHash(parent)
        for _, child in ipairs(parent:GetChildren()) do
            if child:IsA("RemoteEvent") and child.Name:find(HASH, 1, true) then
                return child
            end
            local r = findHash(child)
            if r then return r end
        end
    end
    
    local found = findHash(net)
    if found then
        hook(found)
        return
    end

    setStatus("Auto-detecting remote...", Color3.fromRGB(200, 200, 50))

    local function attach(rem)
        rem.OnClientEvent:Connect(function(a, b, c)
            if remote then return end
            if isBroadcast(a, b, c) then
                hook(rem)
            end
        end)
    end

    local function scan(parent)
        for _, child in ipairs(parent:GetChildren()) do
            if child:IsA("RemoteEvent") then
                attach(child)
            end
            pcall(scan, child)
        end
    end
    scan(net)
    net.DescendantAdded:Connect(function(obj)
        if obj:IsA("RemoteEvent") and not remote then
            attach(obj)
        end
    end)
end)

