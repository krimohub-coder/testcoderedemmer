-- AUTO BUY
-- ============================================
local function doAutoBuy()
    if not enabled then return end
    if not buying then return end
    
    pcall(function()
        local gui = LP:FindFirstChild("PlayerGui")
        if not gui then return end
        
        for _, obj in ipairs(gui:GetDescendants()) do
            if obj:IsA("TextButton") and obj.Visible then
                local text = obj.Text or ""
                local lowerText = string.lower(text)
                
                local isBuy = false
                if string.find(text, "$") then isBuy = true end
                if string.find(lowerText, "purchase") then isBuy = true end
                if string.find(lowerText, "buy") then isBuy = true end
                if string.find(lowerText, "claim") then isBuy = true end
                if string.find(lowerText, "get") then isBuy = true end
                if string.find(lowerText, "spin") then isBuy = true end
                if string.find(lowerText, "wheel") then isBuy = true end
                if string.find(lowerText, "open") then isBuy = true end
                if string.find(lowerText, "collect") then isBuy = true end
                
                if string.find(lowerText, "bought") then isBuy = false end
                if string.find(lowerText, "owned") then isBuy = false end
                
                if isBuy then
                    if obj:FindFirstChild("MouseButton1Click") then
                        for _, conn in ipairs(getconnections(obj.MouseButton1Click)) do
                            pcall(function() conn:Fire() end)
                        end
                    end
                    pcall(function() obj:CaptureFocus() end)
                    pcall(function() obj:ReleaseFocus(true) end)
                    setStatus("Bought: " .. text, Color3.fromRGB(80, 255, 120))
                    break
                end
            end
        end
    end)
end

